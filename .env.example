# Copy to .env beside docker-compose.yml; change RAINY_MUSIC_PATH for an existing music folder.
# Shell environment variables override .env; unset or empty optional values use Compose defaults.
RAINY_IMAGE=yexca/rainy:latest

# Host paths. The music folder is mounted at /data; /config holds the database, the secret key,
# the artwork cache, and the trash — back it up.
RAINY_MUSIC_PATH=./data
RAINY_DATA_PATH=./config
RAINY_HOST_PORT=7650

# Root is the default. To run as the music folder owner instead, set their UID/GID
# (`id <user>` on the NAS), e.g. 1026:100. That user needs write access for editing.
PUID=0
PGID=0
# 002 makes new files group-writable.
UMASK=022
TZ=Asia/Shanghai

# Periodic quick scan ("0" disables). Once saved under Admin → Settings, the saved value wins.
RAINY_SCAN_INTERVAL=1h
RAINY_SCAN_ON_START=true
RAINY_LOG_LEVEL=info
# Only when Rainy sits behind your own reverse proxy: trust X-Real-IP / the last X-Forwarded-For hop.
RAINY_TRUST_PROXY=false
# Web session lifetime (sliding).
RAINY_SESSION_TTL=720h
